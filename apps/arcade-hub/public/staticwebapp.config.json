{
  "routes": [
    { "route": "/football", "redirect": "/football/", "statusCode": 301 },
    { "route": "/hockey", "redirect": "/hockey/", "statusCode": 301 },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/football/*",
      "/hockey/*",
      "/*.{png,jpg,gif,svg,ico,json,css,js,woff,woff2}"
    ]
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "gamepad=(self), fullscreen=(self)"
  },
  "mimeTypes": { ".json": "application/json" }
}
