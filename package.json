{
  "name": "monster-league-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monster League Arcade — retro-modern Halloween sports arcade (Phaser 4 + TypeScript + Vite) on Azure Static Web Apps.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @monster-league/arcade-hub",
    "preview": "npm run preview -w @monster-league/arcade-hub",
    "serve:dist": "node scripts/serve-dist.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
